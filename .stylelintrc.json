{
  "extends": [
    "stylelint-config-standard",
    "stylelint-config-concentric-order"
  ],
  "rules": {
    "no-empty-source": null,
    "selector-class-pattern": "^[a-z0-9]+([-_][a-z0-9]+)*$",
    "selector-id-pattern": "^[a-z0-9]+([-_][a-z0-9]+)*$",
    "keyframes-name-pattern": "^[a-z0-9]+([-_][a-z0-9]+)*$"
  }
}